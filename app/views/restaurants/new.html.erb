<h1 class="mb-4">New restaurant</h1>

<%= simple_form_for @restaurant do |f| %>
  <%= f.input :name %>
  <%= f.input :address %>
  <%= f.input :phone_number %>
  <%= f.input :category, collection: ["chinese", "italian", "japanese", "french", "belgian"] %>

  <%= f.submit class: "btn btn-danger" %>
<% end %>

<hr>

<%= link_to "Back to restaurants", restaurants_path %>
