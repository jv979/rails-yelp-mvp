<h1 class="mb-4">Restaurants</h1>

<div class="row">
  <% @restaurants.each do |restaurant| %>
    <div class="col-md-4 mb-4">
      <div class="card h-100">
        <div class="card-body">
          <h2 class="h4"><%= restaurant.name %></h2>

          <p><%= restaurant.address %></p>
          <p><%= restaurant.phone_number %></p>
          <p><%= restaurant.category.capitalize %></p>

          <%= link_to "See details", restaurant_path(restaurant), class: "btn btn-danger" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
